# Frontend (Vite) — used in local dev and baked at build time on Vercel
# On Vercel production you usually want the relative path so it hits the same domain:
VITE_AI_PROXY_URL=/api/explain

# For local dev against the Fastify server instead:
# VITE_AI_PROXY_URL=http://localhost:3001/api/explain

# --- Server / Vercel serverless (set in Vercel dashboard, not in client) ---
# AI_API_KEY=xai-your-key-here
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.3
