# Required: your LLM API key (never commit the real .env)
AI_API_KEY=xai-your-key-here
# or
# XAI_API_KEY=xai-your-key-here

# Optional overrides
PORT=3001
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.3

# For OpenAI instead:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# AI_API_KEY=sk-...
